{
  "name": "argws/asaas-sdk-playground",
  "description": "Playground para explorar a SDK Asaas.",
  "type": "project",
  "require": {
    "php": "^8.1",
    "slim/slim": "^4.12",
    "slim/psr7": "^1.7",
    "vlucas/phpdotenv": "^5.6",
    "argws/asaas-sdk-php": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Playground\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Playground\\Tests\\": "tests/"
    }
  }
}
