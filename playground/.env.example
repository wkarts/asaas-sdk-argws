ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_APP_NAME=Asaas Playground
ASAAS_TIMEOUT=30
ASAAS_CONNECT_TIMEOUT=10
ASAAS_WEBHOOK_TOKEN=

# URL pública do playground (recomendado quando estiver atrás de reverse proxy)
# Isso evita o Swagger/Scalar gerar servers com porta interna do container (ex.: :8080).
# Ex.: PLAYGROUND_PUBLIC_URL=https://playground-asaas-sdk.argws.com.br
PLAYGROUND_PUBLIC_URL=
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
